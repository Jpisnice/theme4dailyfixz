<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Progressive enhancement hook: CSS and header.js only enable drawer behaviour when this class is present. %}
    <script>document.documentElement.classList.add('js');</script>

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variants (heading and body base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_body_font.system? and settings.type_header_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}
    {% unless settings.type_body_font.system? %}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% unless settings.type_header_font.system? %}
      {{ settings.type_header_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'context.js' | asset_url }}" type="module" defer></script>
    <script src="{{ 'analytics.js' | asset_url }}" type="module" defer></script>
    <script src="{{ 'quick-add.js' | asset_url }}" type="module" defer></script>
    {% case request.page_type %}
      {% when 'index' %}
        {{ 'collection.css' | asset_url | stylesheet_tag }}
        {{ 'home.css' | asset_url | stylesheet_tag }}
      {% when 'collection', 'list-collections' %}
        {{ 'collection.css' | asset_url | stylesheet_tag }}
      {% when 'product' %}
        {{ 'collection.css' | asset_url | stylesheet_tag }}
        {{ 'product.css' | asset_url | stylesheet_tag }}
        {{ 'product-content.css' | asset_url | stylesheet_tag }}
      {% when 'cart' %}
        {{ 'cart.css' | asset_url | stylesheet_tag }}
      {% when 'search', 'article', 'blog', 'page', '404' %}
        {{ 'content.css' | asset_url | stylesheet_tag }}
    {% endcase %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | replace: '_', '-' }}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'mobile-tab-bar' %}

    <div class="visually-hidden" role="status" aria-live="polite" data-quick-add-status></div>
  </body>
</html>
