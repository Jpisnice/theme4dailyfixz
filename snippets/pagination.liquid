{% doc %}
  Renders numbered pagination (previous, numbered links with gaps, next) from
  a `paginate` object. Renders nothing when there is only one page. Links are
  plain anchors built by Shopify, so active filters and sort_by are kept.

  @param {object} paginate - The `paginate` object from inside a `{% paginate %}` tag

  @example
  {% render 'pagination', paginate: paginate %}
{% enddoc %}

{%- if paginate.pages > 1 -%}
  {%- assign current_label = paginate.current_page | append: '' -%}
  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination__list">
      {%- if paginate.previous -%}
        <li>
          <a class="pagination__link pagination__link--step" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous_page' | t }}" rel="prev">
            {{- 'general.pagination.previous' | t -}}
          </a>
        </li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- assign part_label = part.title | append: '' -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__link" href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: page: part.title }}">{{ part.title }}</a>
          {%- elsif part_label == current_label -%}
            <span class="pagination__link pagination__link--current" aria-current="page">
              <span class="visually-hidden">{{ 'general.pagination.current_page' | t: page: part.title }}</span>
              <span aria-hidden="true">{{ part.title }}</span>
            </span>
          {%- else -%}
            <span class="pagination__gap" aria-hidden="true">&hellip;</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li>
          <a class="pagination__link pagination__link--step" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next_page' | t }}" rel="next">
            {{- 'general.pagination.next' | t -}}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
