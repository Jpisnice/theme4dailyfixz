{% doc %}
  Renders the product media gallery: one active main image at a time with a
  thumbnail strip that switches it (enhanced by product.js). Without
  JavaScript every image is shown stacked. Falls back to a placeholder when
  the product has no media.

  @param {product} product - The product whose media to render.

  @example
  {% render 'product-gallery', product: product %}
{% enddoc %}

{%- liquid
  assign media = product.media
  assign featured = product.featured_media
-%}

<div class="gallery" data-gallery>
  <div class="gallery__main" data-gallery-main>
    {%- if media.size > 0 -%}
      {%- for item in media -%}
        {%- liquid
          assign img_loading = 'lazy'
          assign img_priority = 'low'
          assign is_active = false
          if item.id == featured.id
            assign is_active = true
          endif
          if forloop.first and featured == blank
            assign is_active = true
          endif
          if forloop.first
            assign img_loading = 'eager'
            assign img_priority = 'high'
          endif
        -%}
        <div
          class="gallery__slide{% if is_active %} is-active{% endif %}"
          data-gallery-slide
          data-media-id="{{ item.id }}"
        >
          {{
            item
            | image_url: width: 1400
            | image_tag:
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 64em) 48vw, 100vw',
              loading: img_loading,
              fetchpriority: img_priority,
              alt: item.alt | default: product.title,
              class: 'gallery__image'
          }}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="gallery__slide is-active">
        {{ 'product-1' | placeholder_svg_tag: 'gallery__image gallery__placeholder' }}
      </div>
    {%- endif -%}
  </div>

  {%- if media.size > 1 -%}
    <ul class="gallery__thumbs" data-gallery-thumbs role="list">
      {%- for item in media -%}
        {%- liquid
          assign is_active = false
          if item.id == featured.id
            assign is_active = true
          endif
        -%}
        <li>
          <button
            type="button"
            class="gallery__thumb{% if is_active %} is-active{% endif %}"
            data-gallery-thumb
            data-media-id="{{ item.id }}"
            aria-label="{{ item.alt | default: product.title | escape }}"
          >
            {{ item | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '80px', loading: 'lazy', alt: '', class: 'gallery__thumb-image' }}
          </button>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
