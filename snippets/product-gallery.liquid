{% doc %}
  Renders the product media gallery: a scroll-snap track (swipe on touch, native
  scroll without JavaScript), an "n / N" counter, dots on mobile, a thumbnail
  rail on desktop, video support and a full-size lightbox dialog. Images
  open the lightbox; videos play inline and never autoplay. product-gallery.js
  adds the behaviour. Falls back to a placeholder when there is no media.

  Ribbons (offers such as "Buy 1 get 1 free" or "Sale 20% off") sit at the
  top-left of the slider in a variant region, so a sale ribbon follows the
  selected variant.

  @param {product} product - The product whose media to render
  @param {string} [ribbons] - Pre-rendered ribbon markup (span.ribbon elements) shown over the slider

  @example
  {% render 'product-gallery', product: product, ribbons: ribbons_html %}
{% enddoc %}

{%- liquid
  assign media = product.media
  assign featured = product.featured_media
  assign media_total = media.size
-%}

<div
  class="gallery"
  data-gallery
  data-featured="{{ featured.id }}"
  data-label-counter="{{ 'products.gallery.counter' | t: index: '__I__', total: '__T__' }}"
>
  <div class="gallery__stage">
    <div class="ribbons" data-variant-region="ribbons">{{- ribbons | strip -}}</div>

    <ul class="gallery__track" role="list" data-gallery-track tabindex="-1">
      {%- if media_total > 0 -%}
        {%- for item in media -%}
          {%- liquid
            assign img_loading = 'lazy'
            assign img_priority = 'low'
            if forloop.first
              assign img_loading = 'eager'
              assign img_priority = 'high'
            endif
            assign item_alt = item.alt | default: product.title
          -%}
          <li
            class="gallery__slide"
            data-gallery-slide
            data-media-id="{{ item.id }}"
            data-media-type="{{ item.media_type }}"
            aria-roledescription="slide"
            aria-label="{{ 'products.gallery.slide_of' | t: index: forloop.index, total: media_total }}"
          >
            {%- case item.media_type -%}
              {%- when 'video' -%}
                {{ item | video_tag: image_size: '1200x', controls: true, preload: 'none', playsinline: true, class: 'gallery__video' }}
              {%- when 'external_video' -%}
                {{ item | external_video_tag: class: 'gallery__video', loading: 'lazy', title: item_alt }}
              {%- else -%}
                <button
                  type="button"
                  class="gallery__zoom"
                  data-gallery-open
                  data-zoom-src="{{ item.preview_image | image_url: width: 1800 }}"
                  data-zoom-alt="{{ item_alt | escape }}"
                  aria-label="{{ 'products.gallery.zoom' | t }}"
                >
                  {{
                    item.preview_image
                    | image_url: width: 1400
                    | image_tag:
                      widths: '480, 720, 960, 1200, 1400',
                      sizes: '(min-width: 64em) 44vw, (min-width: 48em) 50vw, 100vw',
                      loading: img_loading,
                      fetchpriority: img_priority,
                      alt: item_alt,
                      class: 'gallery__image'
                  }}
                </button>
            {%- endcase -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        <li class="gallery__slide" data-gallery-slide>
          {{ 'product-1' | placeholder_svg_tag: 'gallery__image gallery__placeholder' }}
        </li>
      {%- endif -%}
    </ul>

    {%- if media_total > 1 -%}
      <p class="gallery__counter" aria-hidden="true" data-gallery-counter>1 / {{ media_total }}</p>
      <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="{{ 'products.gallery.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="{{ 'products.gallery.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    {%- endif -%}
  </div>

  {%- if media_total > 1 -%}
    <ul class="gallery__thumbs" data-gallery-thumbs role="list">
      {%- for item in media -%}
        <li>
          <button
            type="button"
            class="gallery__thumb{% if forloop.first %} is-active{% endif %}"
            data-gallery-thumb
            data-media-id="{{ item.id }}"
            aria-label="{{ 'products.gallery.show_image' | t: index: forloop.index, total: media_total }}"
          >
            {{ item.preview_image | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '72px', loading: 'lazy', alt: '', class: 'gallery__thumb-image' }}
          </button>
        </li>
      {%- endfor -%}
    </ul>

    <div class="gallery__dots" role="group" aria-label="{{ 'products.gallery_label' | t }}">
      {%- for item in media -%}
        <button
          type="button"
          class="gallery__dot{% if forloop.first %} is-active{% endif %}"
          data-gallery-thumb
          data-media-id="{{ item.id }}"
          aria-label="{{ 'products.gallery.show_image' | t: index: forloop.index, total: media_total }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <dialog class="lightbox" scroll-lock data-lightbox aria-label="{{ 'products.gallery.lightbox' | t }}">
    <div class="lightbox__inner">
      <button type="button" class="lightbox__close" data-lightbox-close aria-label="{{ 'products.gallery.close' | t }}">{% render 'icon', name: 'close' %}</button>
      <img class="lightbox__image" alt="" width="1200" height="1200" data-lightbox-image>
      <button type="button" class="lightbox__arrow lightbox__arrow--prev" data-lightbox-prev aria-label="{{ 'products.gallery.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      <button type="button" class="lightbox__arrow lightbox__arrow--next" data-lightbox-next aria-label="{{ 'products.gallery.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    </div>
  </dialog>
</div>
