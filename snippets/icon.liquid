{% doc %}
  Renders an inline SVG icon. Icons are decorative (aria-hidden); put the
  accessible name on the surrounding link or button.

  @param {string} name - chevron-left, chevron-right, flame, leaf, shield, box, sparkle, heart, star, check-circle, search, account, home, compass, orders, cart, menu, close, chevron, plus, minus, check, filter, truck, return, lock, tag, copy, instagram, facebook, tiktok, youtube, pinterest, x
  @param {string} [class] - Extra class on the svg

  @example
  {% render 'icon', name: 'search' %}
{% enddoc %}

<svg class="icon icon--{{ name }} {{ class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4.5 20c.9-3.6 3.9-5.5 7.5-5.5s6.6 1.9 7.5 5.5"/>
    {%- when 'cart' -%}
      <path d="M3 4h2.5l2.2 10.2a1 1 0 0 0 1 .8h8.6a1 1 0 0 0 1-.8L20 8H6.2"/><circle cx="9.5" cy="19.5" r="1.2"/><circle cx="17" cy="19.5" r="1.2"/>
    {%- when 'home' -%}
      <path d="M4 11 12 4l8 7"/><path d="M6 10v9.5h4.5V14h3v5.5H18V10"/>
    {%- when 'compass' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>
    {%- when 'orders' -%}
      <path d="M6 3.5h12v17l-3-2-3 2-3-2-3 2z"/><path d="M9 8.5h6M9 12h6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 6-6 6 6 6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6"/>
    {%- when 'flame' -%}
      <path d="M12 3c.5 3-2.5 4.5-2.5 7.5 0 1 .5 2 1.3 2.5-.2-1.700.6-2.700 1.700-3.500 1.800 1.400 4 3.500 4 6.500a5 5 0 0 1-10 0c0-2 .800-3.500 2-5C9.500 7 11 5 12 3z"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 4-13 14-14 0 9-4 14-12 14"/><path d="M5 19c2-4 5-7 9-9"/>
    {%- when 'shield' -%}
      <path d="M12 3.500 5 6v5.500c0 4.200 2.800 7.200 7 9 4.200-1.800 7-4.800 7-9V6z"/><path d="m9 12 2.200 2.200L15.500 10"/>
    {%- when 'box' -%}
      <path d="m12 3 8 4v10l-8 4-8-4V7z"/><path d="m4 7 8 4 8-4M12 11v10"/>
    {%- when 'sparkle' -%}
      <path d="M12 4v4M12 16v4M4 12h4M16 12h4M7 7l2 2M15 15l2 2M17 7l-2 2M9 15l-2 2"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.500-7-10a4 4 0 0 1 7-2.500A4 4 0 0 1 19 10c0 5.500-7 10-7 10z"/>
    {%- when 'star' -%}
      <path d="m12 3.500 2.600 5.300 5.800.8-4.200 4.100 1 5.800-5.200-2.700-5.200 2.700 1-5.800L3.600 9.600l5.800-.8z"/>
    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="9"/><path d="m8 12.500 2.700 2.700L16 9.500"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}
      <path d="m6 6 12 12M18 6 6 18"/>
    {%- when 'chevron' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="17.5" cy="17.5" r="1.5"/>
    {%- when 'return' -%}
      <path d="M9 7 4 12l5 5"/><path d="M4 12h10a5 5 0 0 1 0 10"/>
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
    {%- when 'tag' -%}
      <path d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7a1 1 0 0 1 .7.3l7.8 7.8a1 1 0 0 1 0 1.4l-7.7 7.7a1 1 0 0 1-1.4 0l-7.8-7.8a1 1 0 0 1-.3-.7z"/><circle cx="8" cy="8" r="1.4"/>
    {%- when 'copy' -%}
      <rect x="8.5" y="8.5" width="11.5" height="11.5" rx="2"/><path d="M15.5 8.5V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7.5a2 2 0 0 0 2 2h2.5"/>
    {%- when 'instagram' -%}
      <rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="16.8" cy="7.2" r=".6"/>
    {%- when 'facebook' -%}
      <path d="M14 8h2.5V4.5H14A3.5 3.5 0 0 0 10.5 8v2.5H8V14h2.5v6H14v-6h2.4l.6-3.5H14V8.6c0-.4.2-.6.6-.6z"/>
    {%- when 'tiktok' -%}
      <path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c.3 2.4 1.9 4 4.5 4.2"/>
    {%- when 'youtube' -%}
      <rect x="3" y="6" width="18" height="12" rx="3.5"/><path d="m10.5 9.5 4 2.5-4 2.5z"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M11 16.5 12.5 9.5M10 12.8c-.6-2 .8-3.8 2.6-3.8 1.6 0 2.4 1.2 2.4 2.4 0 1.8-1.1 3.1-2.5 3.1-.8 0-1.3-.5-1.5-1"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'filter' -%}
      <path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/>
    {%- when 'x' -%}
      <path d="M5 5l14 14M19 5 5 19"/>
  {%- endcase -%}
</svg>
