{% doc %}
  Emits the design tokens as :root custom properties, fed by theme settings.
  Rendered once in the <head> of layout/theme.liquid. No parameters.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  {% # Heading font: regular + bold. Body font: regular, bold and italics. %}
  {{ settings.type_header_font | font_face: font_display: 'swap' }}
  {{ settings.type_header_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-heading--family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    --font-heading--style: {{ settings.type_header_font.style }};
    --font-heading--weight: {{ settings.type_header_font.weight }};
    --font-body--family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body--style: {{ settings.type_body_font.style }};
    --font-body--weight: {{ settings.type_body_font.weight }};

    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-muted: {{ settings.muted_color }};
    --color-surface: {{ settings.surface_color }};
    --color-border: {{ settings.border_color }};
    --color-accent: {{ settings.accent_color }};
    --color-accent-contrast: {{ settings.accent_contrast_color }};
    --color-accent-hover: {{ settings.accent_color | color_darken: 8 }};
    --color-accent-strong: {{ settings.accent_color | color_darken: 22 }};
    --color-promo-from: {{ settings.promo_from_color }};
    --color-promo-to: {{ settings.promo_to_color }};
    --color-sale: {{ settings.sale_color }};
    --color-announcement-bg: {{ settings.announcement_background }};
    --color-announcement-text: {{ settings.announcement_text_color }};

    --radius: {{ settings.corner_radius }}px;
    --radius-button: {{ settings.button_radius }}px;
    --radius-lg: {{ settings.corner_radius | plus: 4 }}px;
    --radius-pill: 999px;
    --style-border-radius-inputs: {{ settings.corner_radius }}px;
    --card-ratio: {{ settings.card_image_ratio }};
    --border-width: 1px;

    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.5rem;
    --space-6: 2rem;
    --space-7: 3rem;
    --space-8: 4rem;
    --space-9: 6rem;

    {% # Type scale — fluid above --text-md so there are no per-component sizes. %}
    --text-xs: 0.75rem;
    --text-sm: 0.875rem;
    --text-base: 1rem;
    --text-md: 1.125rem;
    --text-lg: clamp(1.125rem, 1.02rem + 0.5vw, 1.375rem);
    --text-xl: clamp(1.375rem, 1.2rem + 0.9vw, 1.75rem);
    --text-2xl: clamp(1.625rem, 1.4rem + 1.4vw, 2.375rem);
    --text-3xl: clamp(2rem, 1.6rem + 2vw, 3rem);

    --leading-tight: 1.1;
    --leading-snug: 1.3;
    --leading-normal: 1.6;
    --tracking-tight: -0.015em;
    --tracking-wide: 0.04em;
    --tracking-wider: 0.08em;

    --tap-size: 2.75rem;
    --tabbar-height: 4.25rem;

    {% # Soft, ink-based elevation for cards, hover, drawers and dialogs. %}
    --shadow-card: 0 1px 2px rgba(16, 24, 40, 0.04), 0 8px 24px rgba(16, 24, 40, 0.06);
    --shadow-sm: 0 1px 2px rgba(20, 20, 20, 0.04), 0 2px 8px rgba(20, 20, 20, 0.06);
    --shadow-md: 0 4px 12px rgba(20, 20, 20, 0.08), 0 14px 34px rgba(20, 20, 20, 0.1);

    --transition-fast: 120ms;
    --transition-base: 200ms;
    --ease: cubic-bezier(0.4, 0, 0.2, 1);

    --focus-ring: 0.1875rem solid var(--color-accent-strong);
    --focus-offset: 0.1875rem;
  }
{% endstyle %}
