{%- comment -%}
  Rendered only through the Section Rendering API on a product URL
  (/products/handle?section_id=product-card-item) so recently-viewed.js can
  show store-formatted product cards. Not added to templates.
{%- endcomment -%}
{%- if product -%}
  {% render 'product-card', product: product, sizes: '(min-width: 64em) 22vw, (min-width: 48em) 30vw, 44vw' %}
{%- endif -%}

{% schema %}
{
  "name": "t:general.product_card_item",
  "settings": []
}
{% endschema %}
