{%- liquid
  assign menu = section.settings.menu
  assign social_urls = settings.social_instagram | append: settings.social_facebook | append: settings.social_tiktok | append: settings.social_youtube | append: settings.social_pinterest | append: settings.social_x
  assign newsletter_submit = 'footer.newsletter_submit' | t
  assign current_year = 'now' | date: '%Y'
  assign show_country = false
  if localization.available_countries.size > 1
    assign show_country = true
  endif
-%}

<footer class="site-footer">
  {%- if section.settings.show_newsletter -%}
    <div class="site-footer__newsletter page-width">
      <p class="site-footer__newsletter-title">{{ 'footer.newsletter_title' | t }}</p>
      {%- form 'customer', id: 'FooterNewsletter', class: 'site-footer__newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="newsletter__message newsletter__message--success" role="status">{{ 'footer.newsletter_success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="newsletter__message newsletter__message--error" id="FooterNewsletterError" role="alert">{{ 'footer.newsletter_error' | t }}</p>
          {%- endif -%}
          <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'footer.newsletter_label' | t }}</label>
          <div class="newsletter__row">
            <input
              class="input"
              id="FooterNewsletterEmail"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              placeholder="{{ 'footer.newsletter_label' | t }}"
              value="{{ form.email }}"
              {% if form.errors %}aria-invalid="true" aria-describedby="FooterNewsletterError"{% endif %}
            >
            {% render 'button', text: newsletter_submit, type: 'submit' %}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  <div class="site-footer__inner page-width">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__name" href="{{ routes.root_url }}">{{ shop.name }}</a>
        {%- if section.settings.show_blurb and settings.footer_blurb != blank -%}
          <p class="site-footer__blurb">{{ settings.footer_blurb | escape }}</p>
        {%- endif -%}
      </div>

      {%- if menu.links.size > 0 -%}
        <nav class="site-footer__nav" aria-label="{{ menu.title | escape }}">
          <ul class="site-footer__links" role="list">
            {%- for link in menu.links -%}
              <li><a class="site-footer__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if social_urls != blank -%}
        <ul class="social-list" aria-label="{{ 'footer.social_title' | t }}">
          {% render 'social-link', network: 'instagram', url: settings.social_instagram %}
          {% render 'social-link', network: 'facebook', url: settings.social_facebook %}
          {% render 'social-link', network: 'tiktok', url: settings.social_tiktok %}
          {% render 'social-link', network: 'youtube', url: settings.social_youtube %}
          {% render 'social-link', network: 'pinterest', url: settings.social_pinterest %}
          {% render 'social-link', network: 'x', url: settings.social_x %}
        </ul>
      {%- endif -%}
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">{{ 'footer.copyright' | t: year: current_year, shop: shop.name }}</p>

      <div class="site-footer__meta">
        {%- if show_country -%}
          {%- form 'localization', id: 'FooterLocalization', class: 'site-footer__locale', data-auto-submit: '' -%}
            <label class="visually-hidden" for="FooterCountry">{{ 'footer.country' | t }}</label>
            <select class="site-footer__select" id="FooterCountry" name="country_code">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
              {%- endfor -%}
            </select>
            <button type="submit" class="site-footer__locale-submit">{{ 'footer.localization_submit' | t }}</button>
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="payment-icons" aria-label="{{ 'footer.payment_title' | t }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% javascript %}
  document.querySelectorAll('[data-auto-submit]').forEach((form) => {
    form.addEventListener('change', () => form.submit());
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "t:labels.footer_menu_1", "default": "footer" },
    { "type": "checkbox", "id": "show_blurb", "label": "t:labels.footer_show_blurb", "default": false },
    { "type": "checkbox", "id": "show_newsletter", "label": "t:labels.footer_show_newsletter", "default": false },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:labels.show_payment_icons", "default": false }
  ]
}
{% endschema %}
