{%- liquid
  assign hero_image = section.settings.image
  assign hero_heading = section.settings.heading | escape
  assign hero_sub = section.settings.subheading | escape
  assign button_1_label = section.settings.button_label | escape
  assign button_1_link = section.settings.button_link | default: routes.all_products_collection_url
  assign button_2_label = section.settings.button_2_label | escape
  assign button_2_link = section.settings.button_2_link
  assign alignment = section.settings.text_alignment | default: 'left'
  assign hero_alt = hero_image.alt | default: ''
  assign show_buttons = false
  if button_1_label != blank
    assign show_buttons = true
  endif
  if button_2_label != blank and button_2_link != blank
    assign show_buttons = true
  endif
-%}

<div class="hero hero--align-{{ alignment }} full-width" style="--hero-overlay: {{ section.settings.overlay }}">
  <div class="hero__media">
    {%- if hero_image -%}
      {{
        hero_image
        | image_url: width: 1920
        | image_tag:
          widths: '480, 768, 1080, 1440, 1920',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: hero_alt,
          class: 'hero__image'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image hero__placeholder' }}
    {%- endif -%}
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__inner page-width">
    <div class="hero__content">
      {%- if hero_heading != blank -%}
        {% render 'section-heading', heading: hero_heading, subheading: hero_sub, level: 1, class: 'hero__heading' %}
      {%- else -%}
        <h1 class="visually-hidden">{{ shop.name | escape }}</h1>
        {%- if hero_sub != blank -%}
          <p class="hero__sub">{{ hero_sub }}</p>
        {%- endif -%}
      {%- endif -%}
      {%- if show_buttons -%}
        <div class="hero__actions">
          {%- if button_1_label != blank -%}
            {% render 'button', text: button_1_label, url: button_1_link %}
          {%- endif -%}
          {%- if button_2_label != blank and button_2_link != blank -%}
            {% render 'button', text: button_2_label, url: button_2_link, variant: 'secondary' %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image", "info": "t:info.hero_image" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Everyday essentials, done well" },
    { "type": "text", "id": "subheading", "label": "t:labels.subheading", "default": "Simple things you reach for every day, delivered fast." },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Shop all" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link", "info": "t:info.button_link" },
    { "type": "text", "id": "button_2_label", "label": "t:labels.button_2_label" },
    { "type": "url", "id": "button_2_link", "label": "t:labels.button_2_link" },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:labels.text_alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "overlay", "min": 20, "max": 80, "step": 5, "unit": "%", "label": "t:labels.overlay_strength", "info": "t:info.overlay_strength", "default": 40 }
  ],
  "presets": [{ "name": "t:general.hero" }]
}
{% endschema %}
