{%- assign rv_heading = section.settings.heading | escape -%}

<section
  class="recently-viewed page-width"
  data-recently-viewed
  data-current="{{ product.handle }}"
  data-limit="{{ section.settings.limit }}"
  data-root="{{ routes.root_url }}"
  hidden
>
  {%- if rv_heading != blank -%}
    {% render 'section-heading', heading: rv_heading %}
  {%- endif -%}
  <ul class="product-recs__list" role="list" data-rv-list></ul>
</section>

<script src="{{ 'recently-viewed.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "t:general.recently_viewed",
  "settings": [
    { "type": "paragraph", "content": "t:info.recently_viewed" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Recently viewed" },
    { "type": "range", "id": "limit", "label": "t:labels.products_to_show", "min": 2, "max": 8, "step": 1, "default": 6 }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "t:general.recently_viewed" }]
}
{% endschema %}
