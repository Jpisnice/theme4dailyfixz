<section class="page-width content-blog">
  <header class="content-header">
    <h1 class="content-header__title">{{ blog.title }}</h1>
  </header>

  {%- paginate blog.articles by 12 -%}
    <ul class="article-grid" role="list">
      {%- for article in blog.articles -%}
        <li class="article-grid__item">
          <article class="article-card">
            <a class="article-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 48em) 30vw, 92vw', loading: 'lazy', alt: article.title, class: 'article-card__image' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'article-card__image article-card__placeholder' }}
              {%- endif -%}
            </a>
            <div class="article-card__body">
              {%- assign article_date = article.published_at | time_tag: format: 'date' -%}
              <p class="article-card__meta">{{ 'blog.article_metadata_html' | t: date: article_date, author: article.author }}</p>
              <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              {%- if article.excerpt_or_content != blank -%}
                <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              {%- endif -%}
            </div>
          </article>
        </li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}
