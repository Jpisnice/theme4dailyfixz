{%- comment -%}
  Rendered only through the Cart AJAX API `sections` parameter (see product.js)
  to fill the "Added to cart" sheet with store-formatted prices. Every line is
  hidden; product.js reveals the one whose key matches the item just added.
{%- endcomment -%}
{%- liquid
  assign threshold_cents = settings.free_shipping_threshold | times: 100
  assign remaining = threshold_cents | minus: cart.total_price
  assign progress = 0
  if threshold_cents > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold_cents | at_most: 100
  endif
-%}

<div class="cart-added" data-cart-total="{{ cart.total_price }}">
  <ul class="cart-added__lines" role="list">
    {%- for item in cart.items -%}
      <li class="cart-added__line" data-line-key="{{ item.key }}" hidden>
        <div class="cart-added__media">
          {%- if item.image -%}
            {{ item.image | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '64px', loading: 'lazy', alt: '', class: 'cart-added__image' }}
          {%- endif -%}
        </div>
        <div class="cart-added__info">
          <p class="cart-added__name">{{ item.product.title | escape }}</p>
          {%- unless item.product.has_only_default_variant -%}
            <p class="cart-added__variant">{{ item.variant.title | escape }}</p>
          {%- endunless -%}
          <p class="cart-added__qty">{{ 'products.sheet.quantity' | t: count: item.quantity }}</p>
        </div>
        <p class="cart-added__price">{{ item.final_line_price | money }}</p>
      </li>
    {%- endfor -%}
  </ul>

  <p class="cart-added__subtotal">
    <span>{{ 'products.sheet.subtotal' | t: count: cart.item_count }}</span>
    <strong>{{ cart.total_price | money }}</strong>
  </p>

  {%- if threshold_cents > 0 -%}
    <div class="cart-added__shipping">
      <p class="cart-added__shipping-text">
        {%- if remaining > 0 -%}
          {%- assign remaining_money = remaining | money -%}
          {{ 'cart.free_shipping_progress_html' | t: amount: remaining_money }}
        {%- else -%}
          {{ 'cart.free_shipping_reached' | t }}
        {%- endif -%}
      </p>
      <div class="cart-added__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}" aria-label="{{ 'products.sheet.shipping_progress' | t }}">
        <span class="cart-added__fill" style="--progress: {{ progress }}%"></span>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.cart_added",
  "settings": []
}
{% endschema %}
