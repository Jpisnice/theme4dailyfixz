{%- liquid
  assign menu_links = section.settings.menu.links
  assign logo = settings.logo
  assign suggested_terms = section.settings.suggested_terms | split: ','
  assign search_terms = ''
  if request.page_type == 'search'
    assign search_terms = search.terms
  endif
-%}

<header class="site-header" data-header data-cart-url="{{ routes.cart_url }}">
  <div class="site-header__inner page-width">
    <div class="site-header__brand">
      <a class="site-header__home" href="{{ routes.root_url }}">
        {%- if logo -%}
          {%- liquid
            assign logo_height = settings.logo_width | divided_by: logo.aspect_ratio | round
            assign logo_double = settings.logo_width | times: 2
          -%}
          {{
            logo
            | image_url: width: logo_double
            | image_tag:
              width: settings.logo_width,
              height: logo_height,
              widths: '120, 240, 480',
              sizes: '(min-width: 48em) 240px, 160px',
              loading: 'eager',
              alt: shop.name,
              class: 'site-header__logo'
          }}
        {%- else -%}
          <span class="site-header__wordmark">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- if menu_links.size > 0 -%}
      <nav class="site-nav menu" aria-label="{{ 'header.main_menu' | t }}">
        <ul class="menu__list">
          {%- for link in menu_links -%}
            <li class="menu__item{% if link.links.size > 0 %} has-children{% endif %}">
              <a class="menu__link" href="{{ link.url }}"{% if link.active or link.child_active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {%- if link.links.size > 0 -%}
                <ul class="menu__sub">
                  {%- for child in link.links -%}
                    <li>
                      <a class="menu__link menu__link--sub" href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <form
      class="site-search"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      data-predictive-search
      data-predictive-url="{{ routes.predictive_search_url }}"
      data-label-suggestions="{{ 'header.search_suggestions' | t }}"
      data-label-products="{{ 'header.search_products' | t }}"
      data-label-collections="{{ 'header.search_collections' | t }}"
      data-label-all="{{ 'header.search_see_all' | t: terms: '__TERMS__' }}"
      data-label-empty="{{ 'header.search_no_results' | t: terms: '__TERMS__' }}"
      data-label-count="{{ 'header.search_count' | t: count: 99999 | replace: '99999', '__COUNT__' }}"
    >
      <label class="visually-hidden" for="HeaderSearch">{{ 'header.search' | t }}</label>
      <span class="site-search__icon">{% render 'icon', name: 'search' %}</span>
      <input
        id="HeaderSearch"
        class="site-search__input"
        type="search"
        name="q"
        value="{{ search_terms | escape }}"
        placeholder="{{ 'header.search_placeholder' | t }}"
        autocomplete="off"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="HeaderSearchPanel"
        data-search-input
      >
      <input type="hidden" name="options[prefix]" value="last">
      <div class="site-search__panel" id="HeaderSearchPanel" role="listbox" aria-label="{{ 'header.search_suggestions' | t }}" hidden data-search-panel>
        {%- if suggested_terms.size > 0 -%}
          <div class="site-search__group" data-search-suggested hidden>
            <p class="site-search__group-title">{{ 'header.search_suggested' | t }}</p>
            <ul class="site-search__chips" role="presentation">
              {%- for term in suggested_terms -%}
                {%- assign term_text = term | strip -%}
                {%- if term_text != blank -%}
                  <li role="presentation">
                    <a class="site-search__chip" role="option" id="SearchSuggested{{ forloop.index }}" href="{{ routes.search_url }}?q={{ term_text | url_encode }}&options%5Bprefix%5D=last">{{ term_text | escape }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <div data-search-results hidden></div>
      </div>
      <p class="visually-hidden" role="status" aria-live="polite" data-search-status></p>
    </form>

    <div class="site-header__icons">
      {%- if shop.customer_accounts_enabled -%}
        <a class="header-icon header-icon--account" href="{{ routes.account_url }}">
          {% render 'icon', name: 'account' %}
          <span class="visually-hidden">{{ 'header.account' | t }}</span>
        </a>
      {%- endif -%}
      <a
        class="header-icon header-cart"
        href="{{ routes.cart_url }}"
        data-cart-link
        data-label-one="{{ 'header.cart_label' | t: count: 1 }}"
        data-label-other="{{ 'header.cart_label' | t: count: 99999 }}"
      >
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden" aria-live="polite" data-cart-label>{{ 'header.cart_label' | t: count: cart.item_count }}</span>
        <span class="cart-count" aria-hidden="true" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<script src="{{ 'header.js' | asset_url }}" type="module"></script>
<script src="{{ 'predictive-search.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu",
      "info": "t:info.header_menu"
    },
    {
      "type": "text",
      "id": "suggested_terms",
      "label": "t:labels.suggested_terms",
      "info": "t:info.suggested_terms",
      "default": "Cleaning, Kitchen, Storage, Bath"
    }
  ]
}
{% endschema %}
