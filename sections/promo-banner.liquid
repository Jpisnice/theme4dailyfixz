{%- liquid
  assign slides = section.blocks
  assign autoplay_seconds = section.settings.autoplay_seconds
-%}

{%- if slides.size > 0 -%}
  <div
    class="home-section promo page-width{% if slides.size > 1 %} promo--paged{% endif %}"
    data-carousel
    data-autoplay="{{ autoplay_seconds }}"
    data-label-slide="{{ 'home.promo.go_to_slide' | t }}"
    data-label-pause="{{ 'home.promo.pause' | t }}"
    data-label-play="{{ 'home.promo.play' | t }}"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ 'home.promo.label' | t }}"
  >
    <ul class="promo__track" role="list" data-carousel-track tabindex="0">
      {%- for block in slides -%}
        {%- liquid
          assign slide_image = block.settings.image
          assign slide_heading = block.settings.heading | escape
          assign slide_sub = block.settings.subheading | escape
          assign slide_label = block.settings.button_label | escape
          assign slide_link = block.settings.button_link | default: routes.all_products_collection_url
          assign loading = 'lazy'
          if forloop.first
            assign loading = 'eager'
          endif
        -%}
        <li
          class="promo__slide"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ 'home.promo.slide_of' | t: index: forloop.index, total: slides.size }}"
          {% if block.settings.color_from != blank and block.settings.color_to != blank %}
            style="--promo-slide-from: {{ block.settings.color_from }}; --promo-slide-to: {{ block.settings.color_to }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="promo__card">
            <div class="promo__text">
              {%- if slide_heading != blank -%}
                <h2 class="promo__heading">{{ slide_heading }}</h2>
              {%- endif -%}
              {%- if slide_sub != blank -%}
                <p class="promo__sub">{{ slide_sub }}</p>
              {%- endif -%}
              {%- if slide_label != blank -%}
                <a class="button button--accent promo__button" href="{{ slide_link }}">{{ slide_label }}</a>
              {%- endif -%}
            </div>
            {%- if slide_image -%}
              <div class="promo__media">
                {{
                  slide_image
                  | image_url: width: 640
                  | image_tag:
                    widths: '240, 320, 480, 640',
                    sizes: '(min-width: 48em) 320px, 40vw',
                    loading: loading,
                    alt: slide_image.alt | default: '',
                    class: 'promo__image'
                }}
              </div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
  <script src="{{ 'carousel.js' | asset_url }}" type="module" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "t:general.promo_banner",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "t:labels.autoplay_seconds",
      "info": "t:info.autoplay_seconds",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:general.promo_slide",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Save on everyday essentials" },
        { "type": "text", "id": "subheading", "label": "t:labels.subheading", "default": "Top picks for your home, delivered fast." },
        { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "t:labels.button_link", "info": "t:info.button_link" },
        { "type": "image_picker", "id": "image", "label": "t:labels.image" },
        { "type": "color", "id": "color_from", "label": "t:labels.promo_from", "info": "t:info.slide_colors" },
        { "type": "color", "id": "color_to", "label": "t:labels.promo_to" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:general.promo_banner",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
