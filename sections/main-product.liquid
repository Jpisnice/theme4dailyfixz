{%- liquid
  assign current = product.selected_or_first_available_variant

  assign fact_tags = ''
  for tag in product.tags
    if tag contains ':'
      assign tag_prefix = tag | split: ':' | first | strip | downcase
      assign tag_value = tag | split: ':' | slice: 1, 99 | join: ':' | strip
      if tag_prefix == 'fact'
        assign fact_tags = fact_tags | append: tag_value | append: '||'
      endif
    endif
  endfor
  assign facts = fact_tags | split: '||'

  capture stats
    render 'review-stats', product: product
  endcapture
  assign stat_parts = stats | strip | split: '|'
  assign rating_average = stat_parts[0]
  assign rating_total = stat_parts[1] | plus: 0

  assign offers_rendered = false
  assign offer_count = 0
  for block in section.blocks
    if block.type == 'offer' and block.settings.code != blank
      if block.settings.product_tag == blank or product.tags contains block.settings.product_tag
        assign offer_count = offer_count | plus: 1
      endif
    endif
  endfor

  # The image ribbon is only for combo offers ("Buy 1 get 1 free"), from the
  # product's custom.ribbons list. Sales show in the offer marquee and price.
  capture ribbons_html
    for ribbon in product.metafields.custom.ribbons.value limit: 3
      if ribbon != blank
        echo '<span class="ribbon ribbon--combo">'
        echo ribbon | escape
        echo '</span>'
      endif
    endfor
  endcapture

  assign analytics_json = '{"product_id":"' | append: product.id | append: '","handle":"' | append: product.handle | append: '","currency":"' | append: cart.currency.iso_code | append: '"}'
-%}

<section
  class="product"
  data-product
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-recs-url="{{ routes.product_recommendations_url }}"
  data-analytics="{{ analytics_json | escape }}"
  data-label-added="{{ 'products.added' | t }}"
  data-label-add-error="{{ 'products.add_error' | t }}"
  data-label-add="{{ 'products.add_to_cart' | t }}"
  data-label-copied="{{ 'products.offers.copied' | t }}"
  data-label-applied="{{ 'products.offers.applied' | t }}"
  data-label-apply-error="{{ 'products.offers.apply_error' | t }}"
>
  {%- if section.settings.show_offer_marquee -%}
    {% render 'product-offer-marquee', product: product, variant: current, offer_blocks: section.blocks, extra_text: section.settings.marquee_text, speed: section.settings.marquee_speed %}
  {%- endif -%}
  <div class="page-width product__crumbs">
    {% render 'breadcrumbs', product: product %}
  </div>

  <div class="product__layout page-width">
    <div class="product__media">
      {% render 'product-gallery', product: product, ribbons: ribbons_html %}
    </div>

    <div class="product__info">
      <script type="application/json" data-variant-json>{{ product.variants | json }}</script>

      <div class="product__heading">
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="product__vendor">{{ product.vendor | escape }}</p>
        {%- endif -%}
        <h1 class="product__title">{{ product.title }}</h1>
        {%- if facts.size > 0 -%}
          <ul class="product__facts" role="list">
            {%- for fact in facts -%}
              <li class="product__fact">{{ fact | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'rating' -%}
            {%- if rating_total > 0 -%}
              <div class="product__block product__rating" {{ block.shopify_attributes }}>
                {% render 'rating-stars', rating: rating_average, count: rating_total, href: '#reviews' %}
              </div>
            {%- endif -%}

          {%- when 'value_prop' -%}
            {%- liquid
              assign value_prop = product.metafields.custom.value_prop.value
              if value_prop == blank and block.settings.use_description
                assign value_prop = product.description | strip_html | truncatewords: 26
              endif
            -%}
            {%- if value_prop != blank -%}
              <p class="product__block product__value-prop" {{ block.shopify_attributes }}>{{ value_prop | escape }}</p>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="product__block pdp-price-block" {{ block.shopify_attributes }}>
              <div class="pdp-price" data-variant-region="price">
                {%- liquid
                  assign on_sale = false
                  if current.compare_at_price > current.price
                    assign on_sale = true
                    assign saving = current.compare_at_price | minus: current.price
                    assign saving_percent = saving | times: 100 | divided_by: current.compare_at_price
                    assign saving_money = saving | money
                  endif
                -%}
                <div class="pdp-price__row">
                  <span class="pdp-price__current">
                    {%- if on_sale -%}<span class="visually-hidden">{{ 'products.price.sale' | t }}</span>{%- endif -%}
                    {{ current.price | money }}
                  </span>
                  {%- if on_sale -%}
                    <span class="pdp-price__mrp">
                      {{ 'products.price.mrp' | t }} <s><span class="visually-hidden">{{ 'products.price.regular' | t }}</span>{{ current.compare_at_price | money }}</s>
                    </span>
                    <span class="pdp-price__off">{{ 'products.discount_off' | t: percent: saving_percent }}</span>
                  {%- endif -%}
                </div>
                {%- if on_sale -%}
                  <p class="pdp-price__saving">{{ 'products.price.you_save' | t: amount: saving_money }}</p>
                {%- endif -%}
                {%- if current.unit_price_measurement -%}
                  <p class="pdp-price__unit"><span class="visually-hidden">{{ 'products.price.unit' | t }}</span> {{ current.unit_price | unit_price_with_measurement: current.unit_price_measurement }}</p>
                {%- endif -%}
                {%- if cart.taxes_included -%}
                  <p class="pdp-price__tax">{{ 'products.price.taxes_included' | t }}</p>
                {%- endif -%}
              </div>

              {%- assign highlight_count = 0 -%}
              {%- for hl in section.blocks -%}
                {%- if hl.type == 'highlight' -%}{%- assign highlight_count = highlight_count | plus: 1 -%}{%- endif -%}
              {%- endfor -%}
              {%- if highlight_count > 0 -%}
                <ul class="pdp-chips" role="list">
                  {%- for hl in section.blocks -%}
                    {%- if hl.type == 'highlight' -%}
                      <li class="pdp-chip" {{ hl.shopify_attributes }}>
                        {% render 'icon', name: hl.settings.icon %}
                        <span>{{ hl.settings.label | escape }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'offer' -%}
            {%- if offers_rendered == false and offer_count > 0 -%}
              {%- assign offers_rendered = true -%}
              <div class="product__block offers" data-offers {{ block.shopify_attributes }}>
                <h2 class="offers__title">{% render 'icon', name: 'tag' %}{{ 'products.offers.title' | t }}</h2>
                <ul class="offers__list" role="list">
                  {%- for offer in section.blocks -%}
                    {%- if offer.type == 'offer' and offer.settings.code != blank -%}
                      {%- if offer.settings.product_tag == blank or product.tags contains offer.settings.product_tag -%}
                        {%- liquid
                          assign code = offer.settings.code | strip | upcase
                          assign code_param = code | url_encode
                          assign apply_url = '/discount/' | append: code_param | append: '?redirect=' | append: product.url
                        -%}
                        <li class="offer" data-offer data-code="{{ code | escape }}" {{ offer.shopify_attributes }}>
                          <div class="offer__text">
                            {%- if offer.settings.title != blank -%}
                              <p class="offer__headline">{{ offer.settings.title | escape }}</p>
                            {%- endif -%}
                            {%- if offer.settings.details != blank -%}
                              <p class="offer__details">{{ offer.settings.details | escape }}</p>
                            {%- endif -%}
                            {%- if offer.settings.percent_off != blank and offer.settings.percent_off > 0 -%}
                              <p class="offer__best" data-variant-region="offer-{{ offer.id }}">
                                {%- assign pct_left = 100 | minus: offer.settings.percent_off -%}
                                {%- assign best_price = current.price | times: pct_left | divided_by: 100 | money -%}
                                {{ 'products.offers.best_price_html' | t: price: best_price }}
                              </p>
                            {%- endif -%}
                          </div>
                          <div class="offer__actions">
                            <span class="offer__code">{{ code | escape }}</span>
                            <button type="button" class="offer__button offer__copy" data-offer-copy aria-label="{{ 'products.offers.copy_aria' | t: code: code }}">
                              {% render 'icon', name: 'copy' %}<span>{{ 'products.offers.copy' | t }}</span>
                            </button>
                            <a class="offer__button offer__apply" href="{{ apply_url }}" data-offer-apply>{{ 'products.offers.apply' | t }}</a>
                          </div>
                          <p class="offer__status" role="status" aria-live="polite" data-offer-status></p>
                        </li>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            <div class="product__block" {{ block.shopify_attributes }}>
              {% render 'variant-picker', product: product %}
            </div>

          {%- when 'availability' -%}
            {%- liquid
              assign threshold = block.settings.low_stock_threshold | default: 0
              assign stock_state = 'in_stock'
              assign tracked = false
              if current.inventory_management != blank
                assign tracked = true
              endif
              if current.available == false
                assign stock_state = 'out_of_stock'
              elsif tracked and current.inventory_quantity <= 0 and current.inventory_policy == 'continue'
                assign stock_state = 'backorder'
              elsif tracked and threshold > 0 and current.inventory_quantity > 0 and current.inventory_quantity <= threshold
                assign stock_state = 'low_stock'
              endif
            -%}
            <div class="product__block product__availability" data-variant-region="availability" {{ block.shopify_attributes }}>
              <p class="availability availability--{{ stock_state | replace: '_', '-' }}">
                <span class="availability__dot" aria-hidden="true"></span>
                {%- case stock_state -%}
                  {%- when 'low_stock' -%}
                    {{ 'products.availability.low_stock' | t: count: current.inventory_quantity }}
                  {%- when 'out_of_stock' -%}
                    {{ 'products.availability.out_of_stock' | t }}
                  {%- when 'backorder' -%}
                    {{ 'products.availability.backorder' | t }}
                  {%- else -%}
                    {{ 'products.availability.in_stock' | t }}
                {%- endcase -%}
              </p>
              {%- if block.settings.show_sku and current.sku != blank -%}
                <p class="product__sku">{{ 'products.sku' | t: sku: current.sku }}</p>
              {%- endif -%}
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product__block product__buy" data-buy-block {{ block.shopify_attributes }}>
              {%- form 'product', product, id: 'ProductForm', class: 'product-form' -%}
                <div class="product-form__row">
                  {% render 'quantity-input',
                    value: current.quantity_rule.min,
                    min: current.quantity_rule.min,
                    max: current.quantity_rule.max,
                    step: current.quantity_rule.increment,
                    input_id: 'ProductQuantity'
                  %}
                  <button
                    type="submit"
                    name="add"
                    class="button button--primary product-form__submit"
                    data-add-to-cart
                    {% unless current.available %}disabled{% endunless %}
                  >
                    {% render 'icon', name: 'cart' %}
                    <span data-add-label data-variant-region="add-label">
                      {%- if current.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                    </span>
                  </button>
                </div>

                {%- if block.settings.show_buy_now -%}
                  <div class="product-form__buy-now" data-buy-now>
                    {{ form | payment_button }}
                  </div>
                {%- endif -%}

                <p class="product-form__status" role="status" aria-live="polite" data-add-status></p>
              {%- endform -%}

              {%- if block.settings.show_payment_icons -%}
                <div class="secure-pay">
                  <p class="secure-pay__label">{% render 'icon', name: 'lock' %}{{ 'products.secure_pay.label' | t }}</p>
                  {%- if shop.enabled_payment_types.size > 0 -%}
                    <ul class="payment-icons secure-pay__icons" role="list" aria-label="{{ 'products.secure_pay.methods' | t }}">
                      {%- for type in shop.enabled_payment_types limit: 8 -%}
                        <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

          {%- when 'review_highlight' -%}
            {% render 'product-review-pick', product: product, min_rating: block.settings.min_rating, total: rating_total, attributes: block.shopify_attributes %}

          {%- when 'feature_gallery' -%}
            {% render 'product-features', product: product, heading: block.settings.heading, attributes: block.shopify_attributes %}

          {%- when 'delivery' -%}
            {%- liquid
              assign cod_enabled = block.settings.cod_enabled
              assign cod_meta = product.metafields.custom.cod_available.value
              if cod_meta == true
                assign cod_enabled = true
              elsif cod_meta == false
                assign cod_enabled = false
              endif
              assign threshold_cents = settings.free_shipping_threshold | times: 100
              assign threshold_money = threshold_cents | money
              assign dispatch_min = block.settings.dispatch_days_min
              assign dispatch_max = block.settings.dispatch_days_max
            -%}
            <div
              class="product__block delivery"
              data-delivery
              data-serviceable="{{ block.settings.serviceable_prefixes | remove: ' ' | escape }}"
              data-fast="{{ block.settings.fast_prefixes | remove: ' ' | escape }}"
              data-dispatch-min="{{ dispatch_min | default: dispatch_max }}"
              data-dispatch-max="{{ dispatch_max }}"
              data-transit-min="{{ block.settings.transit_days_min | default: block.settings.transit_days_max }}"
              data-transit-max="{{ block.settings.transit_days_max }}"
              data-fast-min="{{ block.settings.fast_transit_days_min | default: block.settings.fast_transit_days_max }}"
              data-fast-max="{{ block.settings.fast_transit_days_max }}"
              data-off-day="{{ block.settings.off_day }}"
              data-cod="{{ cod_enabled }}"
              data-cutoff-hour="{{ block.settings.cutoff_hour }}"
              data-shop-offset="{{ 'now' | date: '%z' }}"
              data-label-cutoff="{{ 'products.delivery.cutoff' | t: time: '__TIME__' }}"
              data-label-hours-minutes="{{ 'products.delivery.hours_minutes' | t: hours: '__H__', minutes: '__M__' }}"
              data-label-hours="{{ 'products.delivery.hours' | t: hours: '__H__' }}"
              data-label-minutes="{{ 'products.delivery.minutes' | t: minutes: '__M__' }}"
              data-label-invalid="{{ 'products.delivery.invalid' | t }}"
              data-label-available="{{ 'products.delivery.available' | t: pin: '__PIN__' }}"
              data-label-unavailable="{{ 'products.delivery.unavailable' | t: pin: '__PIN__' }}"
              data-label-estimate="{{ 'products.delivery.estimate' | t: dates: '__DATES__' }}"
              data-label-cod="{{ 'products.delivery.cod' | t }}"
              {{ block.shopify_attributes }}
            >
              <h2 class="delivery__title">{% render 'icon', name: 'truck' %}{{ 'products.delivery.title' | t }}</h2>

              <div class="delivery__promise" data-delivery-promise hidden>
                <p class="delivery__eta" data-delivery-eta></p>
                <p class="delivery__cutoff" data-delivery-cutoff hidden></p>
              </div>

              {%- if block.settings.show_checker -%}
                <form class="delivery__form" data-delivery-form novalidate>
                  <label class="visually-hidden" for="DeliveryPin">{{ 'products.delivery.pin_label' | t }}</label>
                  <div class="delivery__field">
                    <input
                      class="input delivery__input"
                      id="DeliveryPin"
                      type="text"
                      inputmode="numeric"
                      autocomplete="postal-code"
                      maxlength="6"
                      pattern="[1-9][0-9]{5}"
                      placeholder="{{ 'products.delivery.pin_placeholder' | t }}"
                      data-delivery-input
                    >
                    <button type="submit" class="delivery__button">{{ 'products.delivery.check' | t }}</button>
                  </div>
                  <p class="delivery__result" role="status" aria-live="polite" data-delivery-result></p>
                </form>
              {%- endif -%}

              <ul class="delivery__facts" role="list">
                {%- if dispatch_max != blank -%}
                  <li class="delivery__fact">
                    {% render 'icon', name: 'box' %}
                    {%- if dispatch_min != blank and dispatch_min != dispatch_max -%}
                      <span>{{ 'products.delivery.dispatch_range' | t: min: dispatch_min, max: dispatch_max }}</span>
                    {%- else -%}
                      <span>{{ 'products.delivery.dispatch' | t: days: dispatch_max }}</span>
                    {%- endif -%}
                  </li>
                {%- endif -%}
                {%- if block.settings.shipping_text != blank -%}
                  <li class="delivery__fact">{% render 'icon', name: 'truck' %}<span>{{ block.settings.shipping_text | escape }}</span></li>
                {%- endif -%}
                {%- if threshold_cents > 0 -%}
                  <li class="delivery__fact">{% render 'icon', name: 'truck' %}<span>{{ 'products.delivery.free_shipping' | t: amount: threshold_money }}</span></li>
                {%- endif -%}
                {%- if cod_enabled -%}
                  <li class="delivery__fact">{% render 'icon', name: 'check-circle' %}<span>{{ 'products.delivery.cod' | t }}</span></li>
                {%- endif -%}
                {%- if block.settings.returns_text != blank -%}
                  <li class="delivery__fact">{% render 'icon', name: 'return' %}<span>{{ block.settings.returns_text | escape }}</span></li>
                {%- endif -%}
              </ul>

              {%- if block.settings.show_policy_links -%}
                {%- if shop.shipping_policy or shop.refund_policy -%}
                  <p class="delivery__policies">
                    {%- if shop.shipping_policy -%}
                      <a href="{{ shop.shipping_policy.url }}">{{ 'products.delivery.shipping_policy' | t }}</a>
                    {%- endif -%}
                    {%- if shop.refund_policy -%}
                      <a href="{{ shop.refund_policy.url }}">{{ 'products.delivery.refund_policy' | t }}</a>
                    {%- endif -%}
                  </p>
                {%- endif -%}
              {%- endif -%}
            </div>

          {%- when 'trust_signals' -%}
            {%- liquid
              assign trust_icons = 'lock,shield,return,truck' | split: ','
              assign trust_list = block.settings.text_1 | strip | append: '||' | append: block.settings.text_2 | strip | append: '||' | append: block.settings.text_3 | strip | append: '||' | append: block.settings.text_4 | strip | split: '||'
            -%}
            <ul class="product__block trust" role="list" {{ block.shopify_attributes }}>
              {%- for item in trust_list -%}
                {%- assign trimmed = item | strip -%}
                {%- if trimmed != blank -%}
                  <li class="trust__item">{% render 'icon', name: trust_icons[forloop.index0] %}<span>{{ trimmed | escape }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <details class="pdp-accordion" name="pdp-info" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="pdp-accordion__summary">{{ 'products.description' | t }}</summary>
                <div class="pdp-accordion__body rte">{{ product.description }}</div>
              </details>
            {%- endif -%}

          {%- when 'specs' -%}
            {%- liquid
              assign spec_rows = product.metafields.custom.specs.value
              assign spec_weight = ''
              if current.weight > 0
                assign spec_weight = current.weight | weight_with_unit: current.weight_unit
              endif
              assign has_specs = false
              if spec_rows.size > 0 or product.type != blank or spec_weight != blank
                assign has_specs = true
              endif
              if block.settings.show_vendor and product.vendor != blank
                assign has_specs = true
              endif
            -%}
            {%- if has_specs -%}
              <details class="pdp-accordion" name="pdp-info" {{ block.shopify_attributes }}>
                <summary class="pdp-accordion__summary">{{ 'products.specs.title' | t }}</summary>
                <div class="pdp-accordion__body">
                  <table class="specs" data-variant-region="specs">
                    <tbody>
                      {%- for row in spec_rows -%}
                        {%- if row contains ':' -%}
                          {%- assign spec_label = row | split: ':' | first | strip -%}
                          {%- assign spec_value = row | split: ':' | slice: 1, 99 | join: ':' | strip -%}
                          <tr><th scope="row">{{ spec_label | escape }}</th><td>{{ spec_value | escape }}</td></tr>
                        {%- elsif row != blank -%}
                          <tr><td colspan="2">{{ row | escape }}</td></tr>
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if block.settings.show_vendor and product.vendor != blank -%}
                        <tr><th scope="row">{{ 'products.specs.brand' | t }}</th><td>{{ product.vendor | escape }}</td></tr>
                      {%- endif -%}
                      {%- if product.type != blank -%}
                        <tr><th scope="row">{{ 'products.specs.type' | t }}</th><td>{{ product.type | escape }}</td></tr>
                      {%- endif -%}
                      {%- if spec_weight != blank -%}
                        <tr><th scope="row">{{ 'products.specs.weight' | t }}</th><td>{{ spec_weight }}</td></tr>
                      {%- endif -%}
                    </tbody>
                  </table>
                </div>
              </details>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            {%- liquid
              assign tab_body = block.settings.content
              if tab_body == blank and block.settings.page != blank
                assign tab_body = block.settings.page.content
              endif
            -%}
            {%- if block.settings.heading != blank and tab_body != blank -%}
              <details class="pdp-accordion" name="pdp-info" {{ block.shopify_attributes }}>
                <summary class="pdp-accordion__summary">{{ block.settings.heading | escape }}</summary>
                <div class="pdp-accordion__body rte">{{ tab_body }}</div>
              </details>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {% render 'product-sticky-bar', product: product, variant: current %}
  {% render 'cart-added-sheet' %}

  <script src="{{ 'product-gallery.js' | asset_url }}" type="module" defer></script>
  <script src="{{ 'product.js' | asset_url }}" type="module" defer></script>
  <script src="{{ 'delivery.js' | asset_url }}" type="module" defer></script>
</section>

{% render 'product-structured-data', product: product %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "t:labels.show_vendor", "default": true },
    { "type": "header", "content": "t:general.ribbons" },
    { "type": "paragraph", "content": "t:info.ribbons" },
    { "type": "header", "content": "t:general.offer_marquee" },
    { "type": "paragraph", "content": "t:info.offer_marquee" },
    { "type": "checkbox", "id": "show_offer_marquee", "label": "t:labels.show_offer_marquee", "default": true },
    { "type": "text", "id": "marquee_text", "label": "t:labels.marquee_text", "info": "t:info.marquee_text" },
    { "type": "range", "id": "marquee_speed", "label": "t:labels.marquee_speed", "info": "t:info.marquee_speed", "min": 2, "max": 12, "step": 1, "default": 6 }
  ],
  "blocks": [
    {
      "type": "rating",
      "name": "t:general.rating",
      "limit": 1,
      "settings": [{ "type": "paragraph", "content": "t:info.rating_block" }]
    },
    {
      "type": "value_prop",
      "name": "t:general.value_prop",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "use_description", "label": "t:labels.use_description", "default": false, "info": "t:info.value_prop" }
      ]
    },
    {
      "type": "price",
      "name": "t:general.price",
      "limit": 1,
      "settings": [{ "type": "paragraph", "content": "t:info.price_block" }]
    },
    {
      "type": "offer",
      "name": "t:general.offer",
      "limit": 4,
      "settings": [
        { "type": "paragraph", "content": "t:info.offer_block" },
