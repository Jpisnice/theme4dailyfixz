{%- liquid
  assign benefit_list = product.metafields.custom.benefits.value
  assign block_count = 0
  for block in section.blocks
    if block.settings.title != blank
      assign block_count = block_count | plus: 1
    endif
  endfor
  assign use_list = false
  if benefit_list.size > 0
    assign use_list = true
  endif
-%}

{%- if use_list or block_count > 0 -%}
  <section class="benefits page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="content-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="benefits__grid" role="list">
      {%- if use_list -%}
        {%- for item in benefit_list -%}
          {%- if item != blank -%}
            <li class="benefit">
              <span class="benefit__icon">{% render 'icon', name: 'check-circle' %}</span>
              <p class="benefit__title">{{ item | escape }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.title != blank -%}
            <li class="benefit" {{ block.shopify_attributes }}>
              <span class="benefit__icon">{% render 'icon', name: block.settings.icon %}</span>
              <p class="benefit__title">{{ block.settings.title | escape }}</p>
              {%- if block.settings.text != blank -%}
                <p class="benefit__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:general.product_benefits",
  "settings": [
    { "type": "paragraph", "content": "t:info.product_benefits" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Why you'll love it" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:general.benefit",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.highlight_icon",
          "options": [
            { "value": "sparkle", "label": "t:options.icon.sparkle" },
            { "value": "leaf", "label": "t:options.icon.leaf" },
            { "value": "shield", "label": "t:options.icon.shield" },
            { "value": "heart", "label": "t:options.icon.heart" },
            { "value": "star", "label": "t:options.icon.star" },
            { "value": "box", "label": "t:options.icon.box" },
            { "value": "truck", "label": "t:options.icon.truck" },
            { "value": "return", "label": "t:options.icon.return" },
            { "value": "lock", "label": "t:options.icon.lock" }
          ],
          "default": "sparkle"
        },
        { "type": "text", "id": "title", "label": "t:labels.heading" },
        { "type": "text", "id": "text", "label": "t:labels.body_text" }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "t:general.product_benefits" }]
}
{% endschema %}
