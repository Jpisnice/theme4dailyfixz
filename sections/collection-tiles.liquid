{%- liquid
  assign tiles_heading = section.settings.heading | escape
  assign tile_sizes = '(min-width: 64em) 22vw, (min-width: 48em) 22vw, 46vw'
-%}

{%- capture tiles_markup -%}
  {%- for index in (1..4) -%}
    {%- assign picked = nil -%}
    {%- case index -%}
      {%- when 1 -%}{%- assign picked = section.settings.collection_1 -%}
      {%- when 2 -%}{%- assign picked = section.settings.collection_2 -%}
      {%- when 3 -%}{%- assign picked = section.settings.collection_3 -%}
      {%- when 4 -%}{%- assign picked = section.settings.collection_4 -%}
    {%- endcase -%}
    {%- if picked != blank -%}
      <li class="collection-tiles__item">{% render 'collection-tile', collection_item: picked, sizes: tile_sizes, placeholder_index: index %}</li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign tiles_markup = tiles_markup | strip -%}
{%- if tiles_markup == blank -%}
  {%- capture tiles_markup -%}
    {%- for fallback in collections limit: 4 -%}
      <li class="collection-tiles__item">{% render 'collection-tile', collection_item: fallback, sizes: tile_sizes, placeholder_index: forloop.index %}</li>
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign tiles_markup = tiles_markup | strip -%}
{%- endif -%}

<div class="home-section collection-tiles">
  {%- if tiles_heading != blank -%}
    {% render 'section-heading', heading: tiles_heading %}
  {%- endif -%}
  <ul class="collection-tiles__grid" role="list">
    {%- if tiles_markup != blank -%}
      {{ tiles_markup }}
    {%- else -%}
      {%- for index in (1..4) -%}
        {%- assign placeholder_name = 'collection-' | append: index -%}
        <li class="collection-tiles__item">
          <div class="collection-tile collection-tile--placeholder">
            <span class="collection-tile__media">
              {{ placeholder_name | placeholder_svg_tag: 'collection-tile__image collection-tile__placeholder' }}
            </span>
            <span class="collection-tile__body">
              <span class="collection-tile__title">{{ 'home.placeholder.collection_title' | t }}</span>
            </span>
          </div>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% schema %}
{
  "name": "t:general.collection_tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Shop by collection", "info": "t:info.tiles_fallback" },
    { "type": "collection", "id": "collection_1", "label": "t:labels.collection_1" },
    { "type": "collection", "id": "collection_2", "label": "t:labels.collection_2" },
    { "type": "collection", "id": "collection_3", "label": "t:labels.collection_3" },
    { "type": "collection", "id": "collection_4", "label": "t:labels.collection_4" }
  ],
  "presets": [{ "name": "t:general.collection_tiles" }]
}
{% endschema %}
