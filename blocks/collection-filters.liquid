{% doc %}
  Renders storefront filters for the collection: removable pills for active
  values with a "Clear all" link, and a GET form with a fieldset per filter
  (list and boolean values as chips, price range as two number inputs).
  Nothing is output when the collection has no filters or filters are turned
  off in the theme settings. Without JavaScript the form is an ordinary
  in-flow form with an Apply button; collection.js adds the mobile drawer and
  auto-submit.

  @example
  {% block 'collection-filters' %}{% endblock %}
{% enddoc %}

{%- if collection.filters.size > 0 and settings.collection_show_filters -%}
  {%- assign apply_label = 'collections.filters.apply' | t -%}
  {%- capture filters_active -%}{% render 'filters-active', filters: collection.filters %}{%- endcapture -%}
  <div class="collection-filters" data-collection-filters {{ block.shopify_attributes }}>
    {%- if filters_active != blank -%}
      <div class="filter-pills">
        <h2 class="visually-hidden">{{ 'collections.filters.active_label' | t }}</h2>
        <ul class="filter-pills__list" role="list">
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                {%- liquid
                  assign min_money = filter.min_value.value | money
                  assign max_money = filter.max_value.value | money
                  if filter.min_value.value != blank and filter.max_value.value != blank
                    assign price_pill = 'collections.filters.price_pill_range' | t: min: min_money, max: max_money
                  elsif filter.min_value.value != blank
                    assign price_pill = 'collections.filters.price_pill_min' | t: min: min_money
                  else
                    assign price_pill = 'collections.filters.price_pill_max' | t: max: max_money
                  endif
                  assign price_remove = 'collections.filters.remove_price' | t: value: price_pill
                -%}
                <li>
                  <a class="filter-pill" href="{{ filter.url_to_remove }}" aria-label="{{ price_remove }}">
                    <span>{{ price_pill }}</span>{% render 'icon', name: 'close' %}
                  </a>
                </li>
              {%- endif -%}
            {%- else -%}
              {%- for filter_value in filter.active_values -%}
                {%- assign pill_remove = 'collections.filters.remove_pill' | t: filter: filter.label, value: filter_value.label -%}
                <li>
                  <a class="filter-pill" href="{{ filter_value.url_to_remove }}" aria-label="{{ pill_remove }}">
                    <span>{{ filter_value.label | escape }}</span>{% render 'icon', name: 'close' %}
                  </a>
                </li>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <a class="filter-pills__clear" href="{{ collection.url }}">{{ 'collections.filters.clear_all' | t }}</a>
      </div>
    {%- endif -%}

    <div class="collection-filters__panel" id="CollectionFilters" aria-labelledby="CollectionFiltersTitle" data-filters-panel>
      <div class="collection-filters__head">
        <h2 class="collection-filters__title" id="CollectionFiltersTitle">{{ 'collections.filters.title' | t }}</h2>
        <button type="button" class="collection-filters__close header-icon" data-filters-close>
          {% render 'icon', name: 'close' %}
          <span class="visually-hidden">{{ 'collections.filters.close' | t }}</span>
        </button>
      </div>
      <form class="collection-filters__form" method="get" action="{{ collection.url }}" data-filters-form>
        {%- if collection.sort_by != blank -%}
          <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
        {%- endif -%}
        {%- for filter in collection.filters -%}
          <fieldset class="filter-group">
            <legend class="filter-group__title">{{ filter.label | escape }}</legend>
            {%- if filter.type == 'price_range' -%}
              <div class="filter-price">
                <div class="filter-price__field">
                  <label for="Filter-{{ filter.param_name }}-min">{{ 'collections.filters.price_from' | t }}</label>
                  <input
                    class="input"
                    type="number"
                    inputmode="decimal"
                    min="0"
                    step="any"
                    id="Filter-{{ filter.param_name }}-min"
                    name="{{ filter.min_value.param_name }}"
                    value="{% if filter.min_value.value != blank %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                    placeholder="0"
                  >
                </div>
                <div class="filter-price__field">
                  <label for="Filter-{{ filter.param_name }}-max">{{ 'collections.filters.price_to' | t }}</label>
                  <input
                    class="input"
                    type="number"
                    inputmode="decimal"
                    min="0"
                    step="any"
                    id="Filter-{{ filter.param_name }}-max"
                    name="{{ filter.max_value.param_name }}"
                    value="{% if filter.max_value.value != blank %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                    placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                  >
                </div>
              </div>
              <p class="filter-price__hint">{{ 'collections.filters.price_hint' | t: price: filter.range_max | money }}</p>
            {%- else -%}
              <ul class="filter-group__list" role="list">
                {%- for filter_value in filter.values -%}
                  {%- assign chip_id = 'Filter-' | append: filter.param_name | append: '-' | append: forloop.index -%}
                  {%- assign chip_disabled = false -%}
                  {%- if filter_value.count == 0 and filter_value.active == false -%}
                    {%- assign chip_disabled = true -%}
                  {%- endif -%}
                  <li>
                    <input
                      class="filter-chip__input"
                      type="checkbox"
                      id="{{ chip_id }}"
                      name="{{ filter_value.param_name }}"
                      value="{{ filter_value.value }}"
                      {% if filter_value.active %}checked{% endif %}
                      {% if chip_disabled %}disabled{% endif %}
                    >
                    <label class="filter-chip" for="{{ chip_id }}">
                      <span class="filter-chip__check">{% render 'icon', name: 'check' %}</span>
                      <span class="filter-chip__text">{{ filter_value.label | escape }}</span>
                      <span class="filter-chip__count">({{ filter_value.count }})</span>
                    </label>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </fieldset>
        {%- endfor -%}
        <div class="collection-filters__actions">
          {% render 'button', text: apply_label, type: 'submit', full_width: true %}
        </div>
      </form>
    </div>
    <div class="collection-filters__backdrop" data-filters-backdrop hidden></div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:general.collection_filters",
  "settings": []
}
{% endschema %}
