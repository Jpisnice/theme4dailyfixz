{% doc %}
  Renders a row of product cards from a chosen collection, with a heading
  and an optional "view all" link. When no collection is chosen, or the
  chosen one is empty, it falls back to all products; when the store has no
  products it shows designed placeholder cards. Sold-out products are shown.

  @example
  {% block 'featured-collection' %}{% endblock %}
{% enddoc %}

{%- liquid
  assign source = block.settings.collection
  if source == blank
    assign source = collections.all
  elsif source.products_count == 0
    assign source = collections.all
  endif
  assign card_count = block.settings.product_count | default: 4
  assign featured_heading = block.settings.heading | escape
  assign view_all_url = nil
  assign view_all_text = nil
  if block.settings.show_view_all
    assign view_all_url = source.url
    assign view_all_text = 'home.featured.view_all' | t
  endif
-%}

<div class="home-section featured-collection" {{ block.shopify_attributes }}>
  {%- if featured_heading != blank -%}
    {% render 'section-heading', heading: featured_heading, url: view_all_url, link_text: view_all_text %}
  {%- endif -%}

  {%- if source.products_count > 0 -%}
    <ul class="product-grid" role="list">
      {%- for product in source.products limit: card_count -%}
        <li class="product-grid__item">
          {% render 'product-card', product: product, sizes: '(min-width: 64em) 22vw, (min-width: 48em) 30vw, 46vw' %}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <ul class="product-grid" role="list">
      {%- for index in (1..4) -%}
        {%- assign placeholder_name = 'product-' | append: index -%}
        <li class="product-grid__item">
          <div class="product-card product-card--placeholder">
            <div class="product-card__media">
              {{ placeholder_name | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
            </div>
            <div class="product-card__body">
              <p class="product-card__title">{{ 'home.placeholder.product_title' | t }}</p>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Everyday favourites" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection", "info": "t:info.collection_fallback" },
    { "type": "range", "id": "product_count", "min": 2, "max": 12, "step": 1, "label": "t:labels.product_count", "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "t:labels.show_view_all", "default": true }
  ]
}
{% endschema %}
