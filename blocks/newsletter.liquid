{% doc %}
  Renders a newsletter signup band with heading, text and an email form that
  tags the contact "newsletter". Form and field ids are unique to this block
  instance so it can sit on the same page as the footer signup.

  @example
  {% block 'newsletter' %}{% endblock %}
{% enddoc %}

{%- liquid
  assign form_key = 'PromoNewsletter' | append: block.id
  assign error_id = form_key | append: 'Error'
  assign email_id = form_key | append: 'Email'
  assign newsletter_heading = block.settings.heading | escape
  assign newsletter_text = block.settings.text | escape
  assign submit_label = 'footer.newsletter_submit' | t
-%}

<div class="promo-newsletter full-width" {{ block.shopify_attributes }}>
  <div class="promo-newsletter__inner page-width">
    <div class="promo-newsletter__text">
      {%- if newsletter_heading != blank -%}
        {% render 'section-heading', heading: newsletter_heading, class: 'promo-newsletter__heading' %}
      {%- endif -%}
      {%- if newsletter_text != blank -%}
        <p class="promo-newsletter__sub">{{ newsletter_text }}</p>
      {%- endif -%}
    </div>
    {%- form 'customer', id: form_key, class: 'promo-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="newsletter__message newsletter__message--success" role="status">{{ 'footer.newsletter_success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="newsletter__message newsletter__message--error" id="{{ error_id }}" role="alert">{{ 'footer.newsletter_error' | t }}</p>
        {%- endif -%}
        <label class="promo-newsletter__label" for="{{ email_id }}">{{ 'footer.newsletter_label' | t }}</label>
        <div class="newsletter__row">
          <input
            class="input"
            id="{{ email_id }}"
            type="email"
            name="contact[email]"
            autocomplete="email"
            required
            value="{{ form.email }}"
            {% if form.errors %}aria-invalid="true" aria-describedby="{{ error_id }}"{% endif %}
          >
          {% render 'button', text: submit_label, type: 'submit' %}
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Get the good stuff first" },
    { "type": "textarea", "id": "text", "label": "t:labels.body_text", "default": "New arrivals and everyday offers, straight to your inbox." }
  ]
}
{% endschema %}
