{% doc %}
  Renders a strip of up to three reassurance items (delivery, returns,
  secure checkout) with icons. An item is omitted when its text is blank and
  the strip is omitted when all three are blank. Reusable on any page.

  @example
  {% block 'trust-strip' %}{% endblock %}
{% enddoc %}

{%- liquid
  assign delivery_text = block.settings.delivery_text | escape
  assign returns_text = block.settings.returns_text | escape
  assign checkout_text = block.settings.checkout_text | escape
  assign has_items = false
  if delivery_text != blank or returns_text != blank or checkout_text != blank
    assign has_items = true
  endif
-%}

{%- if has_items -%}
  <div class="trust-strip" {{ block.shopify_attributes }}>
    <ul class="trust-strip__list" role="list">
      {%- if delivery_text != blank -%}
        <li class="trust-strip__item">{% render 'icon', name: 'truck' %}<span>{{ delivery_text }}</span></li>
      {%- endif -%}
      {%- if returns_text != blank -%}
        <li class="trust-strip__item">{% render 'icon', name: 'return' %}<span>{{ returns_text }}</span></li>
      {%- endif -%}
      {%- if checkout_text != blank -%}
        <li class="trust-strip__item">{% render 'icon', name: 'lock' %}<span>{{ checkout_text }}</span></li>
      {%- endif -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:general.trust_strip",
  "settings": [
    { "type": "text", "id": "delivery_text", "label": "t:labels.delivery_text", "info": "t:info.item_blank", "default": "Fast delivery" },
    { "type": "text", "id": "returns_text", "label": "t:labels.returns_text", "info": "t:info.item_blank", "default": "Easy returns" },
    { "type": "text", "id": "checkout_text", "label": "t:labels.checkout_text", "info": "t:info.item_blank", "default": "Secure checkout" }
  ]
}
{% endschema %}
