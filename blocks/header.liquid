{% doc %}
  Renders the storefront header: logo or shop-name wordmark, main menu (an
  off-canvas drawer below 768px when JavaScript is available, inline
  otherwise), search, account and cart links. Invoked statically from
  layout/theme.liquid. Menu comes from the block's menu setting; logo from
  theme settings.

  @example
  {% block 'header' %}{% endblock %}
{% enddoc %}

{%- liquid
  assign menu_links = block.settings.menu.links
  assign logo = settings.logo
-%}

<header class="site-header" data-header data-cart-url="{{ routes.cart_url }}" {{ block.shopify_attributes }}>
  <div class="site-header__inner page-width">
    {%- if menu_links.size > 0 -%}
      <button
        type="button"
        class="site-header__toggle header-icon"
        aria-expanded="false"
        aria-controls="MenuDrawer"
        data-menu-toggle
      >
        {% render 'icon', name: 'menu' %}
        <span class="visually-hidden">{{ 'header.menu_open' | t }}</span>
      </button>
    {%- endif -%}

    <div class="site-header__brand">
      <a class="site-header__home" href="{{ routes.root_url }}">
        {%- if logo -%}
          {%- liquid
            assign logo_height = settings.logo_width | divided_by: logo.aspect_ratio | round
            assign logo_double = settings.logo_width | times: 2
          -%}
          {{
            logo
            | image_url: width: logo_double
            | image_tag:
              width: settings.logo_width,
              height: logo_height,
              widths: '120, 240, 480',
              sizes: '(min-width: 48em) 240px, 160px',
              loading: 'eager',
              alt: shop.name,
              class: 'site-header__logo'
          }}
        {%- else -%}
          <span class="site-header__wordmark">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- if menu_links.size > 0 -%}
      <div class="menu-drawer" id="MenuDrawer" data-menu-drawer>
        <div class="menu-drawer__top">
          <button type="button" class="menu-drawer__close header-icon" data-menu-close>
            {% render 'icon', name: 'close' %}
            <span class="visually-hidden">{{ 'header.menu_close' | t }}</span>
          </button>
        </div>
        <nav class="menu" aria-label="{{ 'header.main_menu' | t }}">
          <ul class="menu__list">
            {%- for link in menu_links -%}
              <li class="menu__item{% if link.links.size > 0 %} has-children{% endif %}">
                <a class="menu__link" href="{{ link.url }}"{% if link.active or link.child_active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                {%- if link.links.size > 0 -%}
                  <button
                    type="button"
                    class="menu__sub-toggle"
                    aria-expanded="false"
                    aria-controls="MenuSub{{ forloop.index }}"
                    data-submenu-toggle
                  >
                    {% render 'icon', name: 'chevron' %}
                    <span class="visually-hidden">{{ 'header.submenu_toggle' | t: title: link.title }}</span>
                  </button>
                  <ul class="menu__sub" id="MenuSub{{ forloop.index }}">
                    {%- for child in link.links -%}
                      <li>
                        <a class="menu__link menu__link--sub" href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
        {%- if shop.customer_accounts_enabled -%}
          <a class="menu-drawer__account" href="{{ routes.account_url }}">
            {% render 'icon', name: 'account' %}
            <span>{{ 'header.account' | t }}</span>
          </a>
        {%- endif -%}
      </div>
      <div class="menu-backdrop" data-menu-backdrop hidden></div>
    {%- endif -%}

    <div class="site-header__icons">
      <a class="header-icon" href="{{ routes.search_url }}">
        {% render 'icon', name: 'search' %}
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="header-icon header-icon--account" href="{{ routes.account_url }}">
          {% render 'icon', name: 'account' %}
          <span class="visually-hidden">{{ 'header.account' | t }}</span>
        </a>
      {%- endif -%}
      <a
        class="header-icon header-cart"
        href="{{ routes.cart_url }}"
        data-cart-link
        data-label-one="{{ 'header.cart_label' | t: count: 1 }}"
        data-label-other="{{ 'header.cart_label' | t: count: 99999 }}"
      >
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden" aria-live="polite" data-cart-label>{{ 'header.cart_label' | t: count: cart.item_count }}</span>
        <span class="cart-count" aria-hidden="true" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<script src="{{ 'header.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
