{% doc %}
  Renders a short brand story: heading, rich text and an image beside it
  (or a placeholder when no image is set). Heading and text are omitted
  when blank.

  @example
  {% block 'brand-story' %}{% endblock %}
{% enddoc %}

{%- liquid
  assign story_heading = block.settings.heading | escape
  assign story_image = block.settings.image
-%}

<div class="brand-story full-width" {{ block.shopify_attributes }}>
  <div class="brand-story__inner page-width">
    <div class="brand-story__media">
      {%- if story_image -%}
        {{
          story_image
          | image_url: width: 1000
          | image_tag:
            widths: '400, 600, 800, 1000',
            sizes: '(min-width: 48em) 45vw, 100vw',
            loading: 'lazy',
            class: 'brand-story__image'
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'brand-story__image brand-story__placeholder' }}
      {%- endif -%}
    </div>
    <div class="brand-story__text">
      {%- if story_heading != blank -%}
        {% render 'section-heading', heading: story_heading, class: 'brand-story__heading' %}
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <div class="brand-story__body">{{ block.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.brand_story",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Made for everyday" },
    { "type": "richtext", "id": "text", "label": "t:labels.body_text", "default": "<p>We pick simple, well-made things that earn their place in your day, and we keep the range small so every item is worth reaching for.</p>" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" }
  ]
}
{% endschema %}
