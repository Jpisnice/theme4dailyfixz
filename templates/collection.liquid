{%- liquid
  assign has_filters = false
  if settings.collection_show_filters
    if collection.filters.size > 0
      assign has_filters = true
    endif
  endif
-%}

{% block 'container' %}
  {% block 'collection-banner' %}{% endblock %}
  {% block 'collection-toolbar' %}{% endblock %}
  <div class="collection-layout{% if has_filters %} collection-layout--filters{% endif %}">
    {% block 'collection-filters' %}{% endblock %}
    <div class="collection-layout__main">
      {% block 'collection-grid' %}{% endblock %}
    </div>
  </div>
{% endblock %}
